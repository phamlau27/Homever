# Supabase Transaction connection pooler (Session/Transaction mode - cổng 6543 hoặc 5432 qua pooler)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=homever"

# Supabase Direct connection (dùng cho Prisma CLI: db push, migrate - cổng 5432 trực tiếp)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=homever"

# AWS Cognito & S3 Configs
AWS_REGION="ap-southeast-1"
COGNITO_USER_POOL_ID="ap-southeast-1_xCmijwwpz"
COGNITO_CLIENT_ID="6r9ajmeb3b63e9j4qhvvfcm82n"
S3_AVATAR_BUCKET="homever-avatars-local-dev"
